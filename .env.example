# ─── SECURITY (REQUIRED FOR PRODUCTION) ────────────────────────────────────────
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_MIN_50_CHARACTERS
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ─── Supabase PostgreSQL (Production) ───────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → Database → Connection parameters
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-strong-supabase-db-password
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432

# ─── Redis (Required for production - cache & Celery) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Email (Production - SMTP) ─────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@mor.gov.et

# ─── CORS (Production - Update with your actual frontend domain) ───────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Frontend URL (for password reset links) ──────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ─── Session Security ─────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
